generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Keep the existing document shapes in PostgreSQL JSONB so the current data
// model and IDs remain intact while the app uses Prisma for database access.
model StoreRecord {
  collection String
  recordId   String
  data       Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([collection, recordId])
  @@index([collection])
  @@map("store_records")
}

model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model StoreCounter {
  key   String @id
  value Int    @default(0)

  @@map("store_counters")
}

// Store data is represented as normal Postgres columns so Supabase's Table
// Editor can browse and filter the business records directly.
model Product {
  id                    String   @id
  createdAt             DateTime @default(now()) @map("created_at")
  discoveryFingerprint  String   @default("") @map("discovery_fingerprint")
  sortOrder             Int      @default(0) @map("sort_order")
  vendorId              String   @map("vendor_id")
  title                 String
  description           String
  price                 Float
  compareAtPrice        Float?   @map("compare_at_price")
  sizePrices            Json?    @map("size_prices")
  giveaway              Boolean  @default(false)
  giveawayAnnouncement  String?  @map("giveaway_announcement")
  availableQuantity     Int      @default(0) @map("available_quantity")
  isAvailable           Boolean  @default(false) @map("is_available")
  images                String[] @default([])
  category              String   @default("Other")
  subcategory           String?
  brand                 String   @default("Unbranded")
  tags                  String[] @default([])
  likesCount            Int      @default(0) @map("likes_count")
  vendorWhatsapp        String   @default("") @map("vendor_whatsapp")
  vendorBusinessName    String?  @map("vendor_business_name")
  location              String?
  condition             String?
  detailGalleryEnabled  Boolean  @default(false) @map("detail_gallery_enabled")
  isLatest              Boolean  @default(false) @map("is_latest")
  isTopSelling          Boolean  @default(false) @map("is_top_selling")
  isFeatured            Boolean  @default(false) @map("is_featured")
  featuredUntil         String?  @map("featured_until")
  relatedProductsMode   String?  @map("related_products_mode")
  relatedProductIds     String[] @default([]) @map("related_product_ids")

  @@index([vendorId])
  @@index([category])
  @@index([isAvailable])
  @@index([category, brand, vendorId, featuredUntil], map: "products_category_brand_vendor_featured_idx")
  @@index([vendorId, createdAt(sort: Desc)], map: "products_vendor_created_at_idx")
  @@index([featuredUntil], map: "products_featured_until_idx")
  @@map("products")
}

model Vendor {
  vendorId          String @id @map("vendor_id")
  sortOrder         Int    @default(0) @map("sort_order")
  username          String @default("")
  businessName      String @map("business_name")
  ownerName         String @map("owner_name")
  email             String
  whatsappNumber    String @map("whatsapp_number")
  businessAddress   String @map("business_address")
  businessCategory  String @map("business_category")
  businessDescription String @map("business_description")
  logo              String @default("")
  status            String
  createdAt         String @map("created_at")
  updatedAt         String? @map("updated_at")
  accessDays        Int?   @map("access_days")
  accessExpiresAt   String? @map("access_expires_at")
  paymentAuthorizedAt String? @map("payment_authorized_at")
  paymentAuthorizedBy String? @map("payment_authorized_by")
  maxProducts       Int?    @map("max_products")
  allowedCategories String[] @default([]) @map("allowed_categories")
  allowedBrands     String[] @default([]) @map("allowed_brands")
  categoryBrands    Json?    @map("category_brands")
  subscriptionStatus String? @map("subscription_status")
  subscriptionExpiresAt String? @map("subscription_expires_at")
  productPolicy     VendorProductPolicy?
  productRequests   VendorProductRequest[]
  upgradeRequests   VendorUpgradeRequest[]

  @@index([email])
  @@index([status])
  @@index([subscriptionStatus], map: "vendors_subscription_status_idx")
  @@map("vendors")
}

model VendorRequest {
  requestId           String  @id @map("request_id")
  sortOrder           Int     @default(0) @map("sort_order")
  status              String
  businessName        String  @map("business_name")
  ownerName           String  @map("owner_name")
  email               String
  username            String  @default("")
  supabaseUid         String? @map("supabase_uid")
  whatsappNumber      String  @map("whatsapp_number")
  businessAddress     String  @map("business_address")
  businessCategory    String  @map("business_category")
  businessDescription String  @map("business_description")
  productMainCategory String  @default("Other Categories") @map("product_main_category")
  productSubcategory  String  @default("Other") @map("product_subcategory")
  requestedBrand      String  @default("Unbranded") @map("requested_brand")
  logo                String  @default("")
  verificationDocType String  @default("") @map("verification_doc_type")
  verificationDocPath String  @default("") @map("verification_doc_path")
  paymentReceiptPath  String  @default("") @map("payment_receipt_path")
  paymentRequired     Boolean @default(false) @map("payment_required")
  paymentAmount       Int?    @map("payment_amount")
  paymentInstructions String  @default("") @map("payment_instructions")
  paymentStatus       String  @default("not_required") @map("payment_status")
  reviewDueAt         String? @map("review_due_at")
  accessDays          Int?    @map("access_days")
  vendorId            String? @map("vendor_id")
  createdAt           String  @map("created_at")
  approvedAt          String? @map("approved_at")
  rejectedAt          String? @map("rejected_at")
  rejectionId         String? @map("rejection_id")
  setupTokenHash      String? @map("setup_token_hash")
  setupTokenExpiresAt String? @map("setup_token_expires_at")
  setupTokenUsedAt    String? @map("setup_token_used_at")

  @@index([email])
  @@index([status])
  @@map("vendor_requests")
}

model VendorProductPolicy {
  vendorId                   String  @id @map("vendor_id")
  mainCategory               String  @map("main_category")
  subcategory                String
  initialProductId           String? @unique @map("initial_product_id")
  initialProductPublishedAt  String? @map("initial_product_published_at")
  createdAt                  String  @map("created_at")
  vendor                     Vendor  @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)

  @@map("vendor_product_policies")
}

model VendorProductRequest {
  requestId           String  @id @map("request_id")
  vendorId            String  @map("vendor_id")
  mainCategory        String  @map("main_category")
  subcategory         String
  productName         String  @map("product_name")
  productDescription  String  @map("product_description")
  productImage        String? @map("product_image")
  reason              String
  status              String  @default("pending")
  adminComment        String? @map("admin_comment")
  reviewedBy          String? @map("reviewed_by")
  createdAt           String  @map("created_at")
  reviewedAt          String? @map("reviewed_at")
  publishedProductId  String? @unique @map("published_product_id")
  fulfilledAt         String? @map("fulfilled_at")
  vendor              Vendor  @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)

  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("vendor_product_requests")
}

model VendorUpgradeRequest {
  id             String   @id
  vendorId       String   @map("vendor_id")
  requestType    String   @map("request_type")
  requestedValue String   @default("") @map("requested_value")
  amountNaira    Int      @map("amount_naira")
  referenceCode  String   @unique @map("reference_code")
  receiptUrl     String?  @map("receipt_url")
  status         String   @default("pending")
  createdAt      String   @map("created_at")
  reviewedAt     String?  @map("reviewed_at")
  reviewedBy     String?  @map("reviewed_by")
  adminNote      String?  @map("admin_note")
  vendor         Vendor  @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)

  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("vendor_upgrade_requests")
}

model OrderRecord {
  orderId          String                   @id @map("order_id")
  sortOrder        Int                      @default(0) @map("sort_order")
  checkoutId       String?                  @map("checkout_id")
  vendorId         String                   @map("vendor_id")
  customerName     String?                  @map("customer_name")
  customerPhone    String?                  @map("customer_phone")
  total            Float
  checkoutMethod   String                   @map("checkout_method")
  status           String
  createdAt        String                   @map("created_at")
  whatsappHandoffAt String?                 @map("whatsapp_handoff_at")
  vendorWhatsapp   String?                  @map("vendor_whatsapp")
  receiptConfirmationTokenHash String?       @unique(map: "orders_receipt_confirmation_token_hash_key") @map("receipt_confirmation_token_hash")
  receiptConfirmationExpiresAt String?       @map("receipt_confirmation_expires_at")
  receiptConfirmationSentAt String?          @map("receipt_confirmation_sent_at")
  customerReceivedAt String?                 @map("customer_received_at")
  items            OrderLine[]
  statusHistory    OrderStatusChange[]

  @@index([vendorId])
  @@index([status])
  @@index([checkoutId])
  @@map("orders")
}

model OrderLine {
  orderId       String      @map("order_id")
  sortOrder     Int         @map("sort_order")
  productId     String      @map("product_id")
  vendorId      String      @map("vendor_id")
  productName   String      @map("product_name")
  selectedSize  String?     @map("selected_size")
  productImage  String?     @map("product_image")
  unitPrice     Float       @map("unit_price")
  quantity      Int
  subtotal      Float
  order         OrderRecord @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@id([orderId, sortOrder])
  @@index([productId])
  @@index([vendorId])
  @@map("order_items")
}

model OrderStatusChange {
  orderId   String      @map("order_id")
  sortOrder Int         @map("sort_order")
  status    String
  at        String
  actor     String
  order     OrderRecord @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@id([orderId, sortOrder])
  @@map("order_status_history")
}

model AnalyticsEvent {
  eventId   String @id @map("event_id")
  sortOrder Int    @default(0) @map("sort_order")
  type      String
  productId String? @map("product_id")
  vendorId  String? @map("vendor_id")
  visitorId String? @map("visitor_id")
  timestamp String
  orderId   String? @map("order_id")

  @@index([type])
  @@index([productId])
  @@index([vendorId])
  @@map("analytics_events")
}

model ProductLike {
  productId String @map("product_id")
  visitorId String @map("visitor_id")
  sortOrder Int    @default(0) @map("sort_order")
  createdAt String @map("created_at")

  @@id([productId, visitorId])
  @@map("product_likes")
}

model CustomerInquiry {
  id        String @id
  sortOrder Int    @default(0) @map("sort_order")
  whatsapp  String
  category  String
  message   String
  createdAt String @map("created_at")
  status    String

  @@index([status])
  @@index([createdAt])
  @@map("customer_inquiries")
}

model ProductFeedback {
  id           String @id
  sortOrder    Int    @default(0) @map("sort_order")
  productId    String @map("product_id")
  productTitle String @map("product_title")
  name         String
  rating       Int
  message      String
  createdAt    String @map("created_at")
  status       String

  @@index([productId])
  @@index([status])
  @@map("product_feedback")
}

model MusicTrack {
  id        String @id
  sortOrder Int    @default(0) @map("sort_order")
  title     String
  file      String
  createdAt String @map("created_at")

  @@map("music_tracks")
}
